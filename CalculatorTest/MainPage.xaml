<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatorTest.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="10"
            VerticalOptions="Center">
            <Label
                Text="Calculator"
                FontSize="32"
                TextColor="Pink"
                HorizontalOptions="Center"/>
            <Entry x:Name="entryNum1"
                   Placeholder="Enter Number"
                   Keyboard="Numeric"
                   TextChanged="entryNum1_TextChanged"/>

            <Entry x:Name="entryNum2"
                   Placeholder="Enter Number"
                   Keyboard="Numeric"
                   TextChanged="entryNum2_TextChanged"/>
            <Label x:Name="txtAnswer"
                   Text="Answer"/>
            <Button x:Name="btnAdd"
                    Text="+"
                    FontSize="50"
                    TextColor="White"
                    BackgroundColor="Pink"
                    Clicked="btnAdd_Clicked"/>
            <Button x:Name="btnSubtract"
                    Text="-"
                    FontSize="50"
                    TextColor="White"
                    BackgroundColor="Pink"
                    Clicked="btnSubtract_Clicked"/>
            <Button x:Name="btnMultiply"
                    Text="*"
                    FontSize="50"
                    TextColor="White"
                    BackgroundColor="Pink"
                    Clicked="btnMultiply_Clicked"/>
            <Button x:Name="btnDivide"
                    Text="/"
                    FontSize="50"
                    TextColor="White"
                    BackgroundColor="Pink"
                    Clicked="btnDivide_Clicked"/>
            

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
