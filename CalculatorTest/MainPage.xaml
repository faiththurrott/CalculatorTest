<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatorTest.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="10"
            Padding="60,0"
            VerticalOptions="Center">
            <Label
                Text="Calculator"
                FontSize="32"
                TextColor="Pink"
                HorizontalOptions="Center"/>
            <Entry x:Name="entryNum1"
                   Placeholder="Enter Number"
                   Keyboard="Numeric"
                   TextChanged="entryNum1_TextChanged"/>

            <Entry x:Name="entryNum2"
                   Placeholder="Enter Number"
                   Keyboard="Numeric"
                   TextChanged="entryNum2_TextChanged"/>
            <Label x:Name="txtAnswer"
                   Text="Answer"/>

            <HorizontalStackLayout
                Spacing ="10"
                HorizontalOptions="Center">
                <Button x:Name="btnAdd"
                    Text="+"
                    Padding="25"
                    FontSize="50"
                    TextColor="White"
                    BackgroundColor="Pink"
                    Clicked="btnAdd_Clicked"/>
                <Button x:Name="btnSubtract"
                    Text="-"
                    Padding="30"
                    FontSize="50"
                    TextColor="White"
                    BackgroundColor="Pink"
                    Clicked="btnSubtract_Clicked"/>
                <Button x:Name="btnPi"
                    Text="π"
                    Padding="22"
                    FontSize="50"
                    TextColor="white"
                    BackgroundColor="pink"
                    Clicked="btnPi_Clicked"/>
            </HorizontalStackLayout>

            <HorizontalStackLayout
                Spacing="10"
                HorizontalOptions="Center">

                <Button x:Name="btnMultiply"
                    Text="*"
                    FontSize="50"
                    Padding="25"
                    TextColor="White"
                    BackgroundColor="Pink"
                    Clicked="btnMultiply_Clicked"/>
                <Button x:Name="btnDivide"
                    Text="/"
                    FontSize="50"
                    Padding="30"
                    TextColor="White"
                    BackgroundColor="Pink"
                    Clicked="btnDivide_Clicked"/>
                <Button x:Name="btnRoot"
                     Text="^"
                     FontSize="50"
                     Padding="25"
                     TextColor="White"
                     BackgroundColor="Pink"
                     Clicked="btnRoot_Clicked"/>

            </HorizontalStackLayout>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
